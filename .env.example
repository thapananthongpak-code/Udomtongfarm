# Copy this file to .env.local and fill in the values.
# Without the Supabase values the site still runs, using the bundled species data,
# but sign-in, saved lists and the admin area are switched off.
# Without the Anthropic key the chat button is not shown.

# Public address of the site, without a trailing slash. Used for share links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://udomtongfarm.vercel.app

# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic Console -> API keys. Powers the chat assistant (Claude Haiku).
# Keep this one secret: never give it a NEXT_PUBLIC_ name and never commit it.
ANTHROPIC_API_KEY=
