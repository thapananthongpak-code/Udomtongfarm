# This file is a template and is published on GitHub. Never put real keys in it.
# Copy it to .env.local and fill in the values there: .env.local stays on your computer.
# The site runs without any of them, using the bundled species data.
# Sign-in, saved lists and the admin dashboard need the Supabase values.
# The chat button only appears once the Gemini key is set.

# Public address of the site, without a trailing slash. Used for the sitemap.
VITE_SITE_URL=https://udomtongfarm.vercel.app

# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AI Studio -> Get API key. Powers the chat assistant (Gemini).
# Keep this one secret: never give it a VITE_ name and never commit it.
GEMINI_API_KEY=
